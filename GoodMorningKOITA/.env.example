NAVER_CLIENT_ID=여기에_Client_ID
NAVER_CLIENT_SECRET=여기에_Client_Secret
# (선택) 기사 DB를 둘 폴더. 비우면 프로그램 폴더 안의 database 폴더
ARCHIVE_DIR=
# (선택) 지면보도 날짜 확인에 쓸 지면 기사 파일 폴더 (예: C:\Users\이름\Desktop\News\Newspaper)
NEWSPAPER_DIR=
# (선택) 1이면 지면 확인할 때 브라우저 창을 띄움
BROWSER_SHOW=
# (선택) 로그인 비밀번호. 다른 PC·폰에서 접속하게 열 때는 꼭 넣기
APP_PASSWORD=
# (선택) 로그인 유지용 비밀값(아무 긴 문자열). 넣으면 서버를 다시 켜도 로그인이 풀리지 않음
SESSION_SECRET=
# (선택) 데이터 폴더(news.db, database 폴더). 비우면 프로그램 폴더. 클라우드 서버에서는 /data
DATA_DIR=
# (선택) 서버 주소·포트. 클라우드 서버에서는 HOST=0.0.0.0
HOST=
PORT=
# (선택) 0이면 켤 때 브라우저를 자동으로 열지 않음
OPEN_BROWSER=
